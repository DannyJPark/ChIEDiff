# Written from scratch, not inherited. Everything here is build output or a runtime
# artifact. Nothing is re-included with `!`: if a path is not listed below it ships,
# which is the property that makes the shipped set auditable.

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.venv/
venv/

# Run artifacts. Training and sampling write here; none of it is source.
logs/
logs_slurm/
logs_diffusion/
checkpoints/
*.lmdb
*.lmdb-lock
*_filename_mapping.pkl

# Downloaded archive contents (weights, samples, receptors). tools/download_archive.py
# populates these; they carry their own DOI and are never committed.
archive/

# Generated figures. Every figure except figures/main_figure_fixed2.png is produced by a
# script in figure_build/; the exception is declared in figure_build/figures/PROVENANCE.md.
figure_build/figures/generated/
figure_build/figures/panels/*.png

# Derived table data. build_revision_tables.py regenerates all of these from results/ on
# every `make tables`, so they are build output, not source. The other files in paper/data/
# (score_distributions.csv.gz, round2_vinardo_pairs.csv.gz and the four manifests) ARE
# inputs and are tracked.
paper/data/ablation_OFF.csv
paper/data/ablation_ON.csv
paper/data/ablation_plip.csv
paper/data/coverage.csv
paper/data/distributions.csv
paper/data/main_ablation.csv
paper/data/main_chemistry.csv
paper/data/main_quality.csv
paper/data/pose_table.csv
paper/data/posebusters.csv
paper/data/properties.csv
paper/data/specificity_audit.csv
paper/data/manifest.json
paper/data/table_specs.json

# LaTeX build products of the table harness
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
tables/*.aux
tables/*.log
tables/*.out
tables/*.toc
tables/*.fls
tables/*.fdb_latexmk
tables/*.synctex.gz

# Editors / OS
.vscode/
.idea/
.claude/
*.swp
*~
.DS_Store
