# Everything listed here is build output or a runtime artifact. Nothing is re-included
# with `!`, so a path that is not listed below ships, which is what makes the shipped set
# auditable.

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.venv/
venv/

# Run artifacts. Training, sampling and measurement write here; none of it is source.
logs/
logs_slurm/
logs_diffusion/
checkpoints/
*.lmdb
*.lmdb-lock
*_filename_mapping.pkl
eval_out/
eval_plip/

# Downloaded archive contents: weights, molecules, receptors and the training LMDB.
# tools/download_archive.py populates these. They carry their own DOI.
archive/
data/test_set
data/test_set_chainfix

# Notebook state
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.claude/
*.swp
*~
.DS_Store
